DirectoryIndex disabled
RewriteEngine On

# 1. Se a rota for /api, passe direto para o Node.js (não tente achar arquivo)
RewriteRule ^api/ - [L]

# 2. Se o arquivo ou diretório existir fisicamente, sirva-o (imagens, css, js)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 3. Caso contrário, envie para o index.html (SPA) ou deixe o Node tratar
# Na Hostinger com Passenger, o Node assume aqui.
RewriteRule . /index.html [L]